# 链。主网保持 56。本地 Anvil 用 31337，并把 RPC 指到 http://127.0.0.1:8545。
VITE_CHAIN_ID=56
VITE_RPC_URL=https://bsc-dataseed.bnbchain.org

# BSC 主网 Namepay。留空时前端使用同一地址。
VITE_NAMEPAY_ADDRESS=0xE762448Cd6a9887e00c380de3dC6DaAE06aB2FeD

# 下面两个地址是主网默认值，一般不用改。
VITE_AGENT_ID_ADDRESS=0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F
VITE_USDC_ADDRESS=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d

# 在 https://cloud.walletconnect.com 免费创建一个项目，把 Project ID 填到这里。
# 不要把别人的 id 写进仓库。留空时只显示注入钱包。
VITE_WALLETCONNECT_PROJECT_ID=
